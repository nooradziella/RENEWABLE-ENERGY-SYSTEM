                    </div>
                </div>
            </div>
        </section>

        <!-- SECTION 2: MODUL 5 TOPIK REVISION & INTERACTION -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
            
            <!-- Sidebar Navigasi Topik -->
            <nav class="lg:col-span-4 bg-slate-900 border border-slate-800 rounded-2xl p-3 shadow-xl space-y-1.5">
                <div class="px-3 py-2 text-xs font-bold uppercase tracking-wider text-slate-400 border-b border-slate-800/80 flex justify-between items-center">
                    <span>Modul Pembelajaran</span>
