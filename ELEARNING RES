                            <span class="text-xs uppercase font-extrabold tracking-wider text-slate-400">Tahap Kefahaman</span>
                        </div>
                        <h2 id="mastery-status-text" class="text-xl sm:text-2xl font-black text-rose-400 mt-0.5 tracking-tight">Perlu Bimbingan</h2>
                        <p id="mastery-desc-text" class="text-xs text-slate-400 mt-1 leading-relaxed">
