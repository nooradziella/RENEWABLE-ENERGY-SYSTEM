                        <div class="mt-3 flex flex-wrap items-center justify-center sm:justify-start gap-2 text-[11px] font-semibold text-slate-300">
                            <span class="bg-slate-800 px-2.5 py-1 rounded-md border border-slate-700/80">
                                <i class="fa-solid fa-list-check text-brand-teal mr-1"></i>
                                Kuiz: <strong class="text-white" id="overall-quiz-ratio">0/15</strong> Dijawab
                            </span>
                            <span class="bg-slate-800 px-2.5 py-1 rounded-md border border-slate-700/80">
                                <i class="fa-solid fa-circle-check text-emerald-400 mr-1"></i>
                                Ketepatan: <strong class="text-white" id="overall-accuracy">0%</strong>
                            </span>
                        </div>
                    </div>
                </div>

                <!-- 5 Topics Breakdown Cards -->
                <div class="lg:col-span-7">
                    <div class="flex justify-between items-center mb-3">
                        <h3 class="text-xs uppercase tracking-wider font-extrabold text-slate-400 flex items-center gap-1.5">
                            <i class="fa-solid fa-chart-simple text-brand-teal"></i>
                            Pemahaman Mengikut Topik
