            <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
                <!-- Kalkulator 1: Fill Factor & Pmax Solar PV -->
                <div class="bg-slate-950 p-4 rounded-xl border border-slate-800 flex flex-col justify-between">
                    <div>
                        <div class="flex items-center justify-between">
                            <span class="text-xs font-bold text-brand-gold flex items-center gap-1.5">
                                <i class="fa-solid fa-solar-panel"></i> 1. Solar PV: Fill Factor (FF)
                            </span>
                            <span class="text-[10px] text-slate-400 bg-slate-900 px-2 py-0.5 rounded">Bab 1</span>
                        </div>
                        <p class="text-[11px] text-slate-400 mt-1.5 font-mono text-center bg-slate-900/60 p-1 rounded border border-slate-800">
                            FF = Pmax / (Voc × Isc) = (Vmp × Imp) / (Voc × Isc)
                        </p>
                        
                        <div class="grid grid-cols-2 gap-2 mt-3 text-xs">
                            <div>
                                <label class="text-[10px] text-slate-400 block mb-0.5">Voc (V):</label>
                                <input type="number" id="calc-voc" value="21.6" step="0.1" class="w-full bg-slate-900 border border-slate-700 rounded-lg p-1.5 text-white font-mono text-center focus:border-brand-teal focus:outline-none">
                            </div>
                            <div>
                                <label class="text-[10px] text-slate-400 block mb-0.5">Isc (A):</label>
                                <input type="number" id="calc-isc" value="5.8" step="0.1" class="w-full bg-slate-900 border border-slate-700 rounded-lg p-1.5 text-white font-mono text-center focus:border-brand-teal focus:outline-none">
                            </div>
                            <div>
                                <label class="text-[10px] text-slate-400 block mb-0.5">Vmp (V):</label>
                                <input type="number" id="calc-vmp" value="17.2" step="0.1" class="w-full bg-slate-900 border border-slate-700 rounded-lg p-1.5 text-white font-mono text-center focus:border-brand-teal focus:outline-none">
                            </div>
                            <div>
                                <label class="text-[10px] text-slate-400 block mb-0.5">Imp (A):</label>
                                <input type="number" id="calc-imp" value="5.1" step="0.1" class="w-full bg-slate-900 border border-slate-700 rounded-lg p-1.5 text-white font-mono text-center focus:border-brand-teal focus:outline-none">
                            </div>
                        </div>
                    </div>

                    <div class="mt-4 pt-3 border-t border-slate-800">
                        <button onclick="kiraFillFactor()" class="w-full py-1.5 rounded-lg bg-brand-gold hover:bg-amber-400 text-slate-950 font-bold text-xs transition">
                            Kira FF & Pmax
                        </button>
                        <div id="output-calc-pv" class="mt-2.5 p-2 bg-slate-900 rounded-lg border border-slate-800 text-center">
                            <span class="text-xs text-slate-400">Pmax: <strong class="text-white font-mono">87.72 W</strong></span> | 
                            <span class="text-xs text-brand-gold">FF: <strong class="font-mono">0.700</strong> (70.0%)</span>
                        </div>
                    </div>
                </div>

                <!-- Kalkulator 2: Kuasa Turbin Angin -->
                <div class="bg-slate-950 p-4 rounded-xl border border-slate-800 flex flex-col justify-between">
                    <div>
                        <div class="flex items-center justify-between">
                            <span class="text-xs font-bold text-brand-teal flex items-center gap-1.5">
                                <i class="fa-solid fa-wind"></i> 2. Wind Turbine Power
                            </span>
                            <span class="text-[10px] text-slate-400 bg-slate-900 px-2 py-0.5 rounded">Bab 2</span>
                        </div>
                        <p class="text-[11px] text-slate-400 mt-1.5 font-mono text-center bg-slate-900/60 p-1 rounded border border-slate-800">
                            P = 0.5 × &rho; × (&pi; r²) × v³ × &eta;
                        </p>
                        
                        <div class="grid grid-cols-2 gap-2 mt-3 text-xs">
                            <div>
                                <label class="text-[10px] text-slate-400 block mb-0.5">&rho; Udara (kg/m³):</label>
                                <input type="number" id="calc-wind-rho" value="1.225" step="0.005" class="w-full bg-slate-900 border border-slate-700 rounded-lg p-1.5 text-white font-mono text-center focus:border-brand-teal focus:outline-none">
                            </div>
                            <div>
                                <label class="text-[10px] text-slate-400 block mb-0.5">Jejari Bilah r (m):</label>
                                <input type="number" id="calc-wind-radius" value="6.0" step="0.5" class="w-full bg-slate-900 border border-slate-700 rounded-lg p-1.5 text-white font-mono text-center focus:border-brand-teal focus:outline-none">
                            </div>
                            <div>
                                <label class="text-[10px] text-slate-400 block mb-0.5">Halaju v (m/s):</label>
                                <input type="number" id="calc-wind-v" value="8.0" step="0.5" class="w-full bg-slate-900 border border-slate-700 rounded-lg p-1.5 text-white font-mono text-center focus:border-brand-teal focus:outline-none">
                            </div>
                            <div>
                                <label class="text-[10px] text-slate-400 block mb-0.5">Kecekapan &eta; (max 0.593):</label>
                                <input type="number" id="calc-wind-eff" value="0.40" step="0.05" max="0.593" class="w-full bg-slate-900 border border-slate-700 rounded-lg p-1.5 text-white font-mono text-center focus:border-brand-teal focus:outline-none">
                            </div>
                        </div>
                    </div>

                    <div class="mt-4 pt-3 border-t border-slate-800">
                        <button onclick="kiraWindPower()" class="w-full py-1.5 rounded-lg bg-brand-teal hover:bg-cyan-400 text-slate-950 font-bold text-xs transition">
                            Kira Kuasa Diekstrak
                        </button>
                        <div id="output-calc-wind" class="mt-2.5 p-2 bg-slate-900 rounded-lg border border-slate-800 text-center">
                            <span class="text-xs text-slate-400">Total Angin: <strong class="text-white font-mono">35.48 kW</strong></span> | 
                            <span class="text-xs text-brand-teal">Output: <strong class="font-mono">14.19 kW</strong></span>
                        </div>
                    </div>
                </div>

                <!-- Kalkulator 3: Kuasa Loji Hidroelektrik -->
                <div class="bg-slate-950 p-4 rounded-xl border border-slate-800 flex flex-col justify-between">
                    <div>
                        <div class="flex items-center justify-between">
                            <span class="text-xs font-bold text-sky-400 flex items-center gap-1.5">
                                <i class="fa-solid fa-water"></i> 3. Hydroelectric Output Power
                            </span>
                            <span class="text-[10px] text-slate-400 bg-slate-900 px-2 py-0.5 rounded">Bab 3</span>
                        </div>
                        <p class="text-[11px] text-slate-400 mt-1.5 font-mono text-center bg-slate-900/60 p-1 rounded border border-slate-800">
                            P = &rho; × g × Q × H × &eta;  (&rho;=1000, g=9.81)
                        </p>
                        
                        <div class="grid grid-cols-3 gap-2 mt-3 text-xs">
                            <div>
                                <label class="text-[10px] text-slate-400 block mb-0.5">Aliran Q (m³/s):</label>
                                <input type="number" id="calc-hydro-q" value="0.10" step="0.05" class="w-full bg-slate-900 border border-slate-700 rounded-lg p-1.5 text-white font-mono text-center focus:border-brand-teal focus:outline-none">
                            </div>
                            <div>
                                <label class="text-[10px] text-slate-400 block mb-0.5">Head H (m):</label>
                                <input type="number" id="calc-hydro-h" value="100" step="5" class="w-full bg-slate-900 border border-slate-700 rounded-lg p-1.5 text-white font-mono text-center focus:border-brand-teal focus:outline-none">
                            </div>
                            <div>
                                <label class="text-[10px] text-slate-400 block mb-0.5">Kecekapan &eta;:</label>
                                <input type="number" id="calc-hydro-eff" value="0.85" step="0.05" max="1" class="w-full bg-slate-900 border border-slate-700 rounded-lg p-1.5 text-white font-mono text-center focus:border-brand-teal focus:outline-none">
                            </div>
                        </div>
                    </div>

                    <div class="mt-4 pt-3 border-t border-slate-800">
                        <button onclick="kiraHydroPower()" class="w-full py-1.5 rounded-lg bg-sky-500 hover:bg-sky-400 text-slate-950 font-bold text-xs transition">
                            Kira Kuasa Hidro (kW)
                        </button>
                        <div id="output-calc-hydro" class="mt-2.5 p-2 bg-slate-900 rounded-lg border border-slate-800 text-center">
                            <span class="text-xs text-slate-400">P Output = </span>
                            <strong class="text-sky-300 font-mono text-xs">83.39 kW</strong>
                            <span class="text-[10px] text-slate-500 block font-mono">(0.083 MW)</span>
                        </div>
                    </div>
                </div>
            </div>
        </section>

    </main>

    <!-- Footer -->
    <footer class="bg-slate-950 border-t border-slate-900 py-6 mt-12 text-xs text-slate-500">
