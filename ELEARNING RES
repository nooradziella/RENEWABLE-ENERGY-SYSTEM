                            <span class="w-5 h-5 rounded-md bg-slate-900 text-brand-teal border border-slate-800 flex items-center justify-center text-xs font-black">
                                ${idx + 1}
                            </span>
                            ${sec.title}
                        </h4>
                        <ul class="space-y-2 text-xs text-slate-300 leading-relaxed">
                            ${sec.points.map(pt => `
                                <li class="flex items-start gap-2">
                                    <i class="fa-solid fa-angle-right text-brand-teal text-[11px] mt-1 flex-shrink-0"></i>
                                    <div>${pt}</div>
                                </li>
                            `).join('')}
                        </ul>
                    </div>
                `;
            });

            html += `</div>`;
            container.innerHTML = html;
        }

        function renderKuizPengukuhan(container, topic) {
            let html = `
                <div class="space-y-5">
                    <div class="p-3 bg-slate-950 rounded-xl border border-slate-800 flex items-center justify-between text-xs">
                        <span class="text-slate-400"><i class="fa-solid fa-circle-question text-brand-gold mr-1"></i> Selesaikan 3 soalan pengukuhan konsep & pengiraan ini.</span>
                        <span class="text-brand-teal font-bold font-mono">Skor Terkini: ${kiraBetulKuizTopik(topic.id)}/3 Betul</span>
                    </div>
            `;

            topic.quizzes.forEach((qItem, qIdx) => {
                const saved = appState.quizAnswers[qItem.id];
                const isAnswered = (saved !== undefined);

                html += `
                    <div class="bg-slate-950/90 rounded-xl border ${isAnswered ? (saved.isCorrect ? 'border-emerald-500/40 bg-emerald-950/10' : 'border-rose-500/40 bg-rose-950/10') : 'border-slate-800'} p-4 shadow-sm" id="box-${qItem.id}">
                        <div class="flex items-start justify-between gap-3">
                            <h4 class="text-xs sm:text-sm font-bold text-white leading-snug">
                                <span class="text-brand-teal font-mono mr-1">S${qIdx + 1}.</span> ${qItem.q}
                            </h4>
                            ${isAnswered ? (
                                saved.isCorrect ? 
                                '<span class="text-[10px] font-bold bg-emerald-500/20 text-emerald-400 border border-emerald-500/40 px-2 py-0.5 rounded-full flex items-center gap-1 flex-shrink-0"><i class="fa-solid fa-check"></i> Tepat</span>' : 
                                '<span class="text-[10px] font-bold bg-rose-500/20 text-rose-400 border border-rose-500/40 px-2 py-0.5 rounded-full flex items-center gap-1 flex-shrink-0"><i class="fa-solid fa-xmark"></i> Kurang Tepat</span>'
                            ) : '<span class="text-[10px] bg-slate-800 text-slate-400 px-2 py-0.5 rounded-full flex-shrink-0">Belum Selesai</span>'}
                        </div>

                        <!-- Pilihan Jawapan -->
                        <div class="mt-3.5 space-y-2">
                `;

                qItem.options.forEach((opt, optIdx) => {
                    let optStyle = "bg-slate-900 border-slate-800 text-slate-300 hover:border-slate-700 hover:bg-slate-850";
                    if (isAnswered) {
                        if (optIdx === qItem.ans) {
                            optStyle = "bg-emerald-950/50 border-emerald-500 text-emerald-200 font-semibold";
                        } else if (saved.selected === optIdx && !saved.isCorrect) {
                            optStyle = "bg-rose-950/50 border-rose-500 text-rose-200";
                        } else {
                            optStyle = "bg-slate-900/60 border-slate-900 text-slate-500 opacity-60";
                        }
                    }

                    html += `
                        <button onclick="pilihJawapanKuiz('${qItem.id}', ${optIdx})" 
                                ${isAnswered ? 'disabled' : ''} 
                                class="w-full text-left p-2.5 sm:p-3 rounded-lg border text-xs flex items-center justify-between gap-2 transition ${optStyle}">
                            <div class="flex items-center gap-2.5">
                                <span class="w-5 h-5 rounded-md flex items-center justify-center font-mono text-[10px] font-black ${isAnswered && optIdx === qItem.ans ? 'bg-emerald-500 text-slate-950' : 'bg-slate-800 text-slate-300'}">
                                    ${String.fromCharCode(65 + optIdx)}
                                </span>
                                <span>${opt}</span>
                            </div>
                            ${isAnswered && optIdx === qItem.ans ? '<i class="fa-solid fa-check-double text-emerald-400"></i>' : ''}
                        </button>
                    `;
                });

                html += `</div>`;

                // Skema & Penjelasan Pensyarah
                if (isAnswered) {
                    html += `
                        <div class="mt-3.5 p-3 rounded-lg bg-slate-900/90 border border-slate-800 text-xs text-slate-300 animate-fadeIn">
                            <div class="font-bold text-brand-teal flex items-center gap-1.5 mb-1">
                                <i class="fa-solid fa-chalkboard-user"></i> Skema & Penerangan Konsep:
                            </div>
                            <p class="text-slate-300 leading-relaxed text-[11px]">${qItem.expl}</p>
                        </div>
                    `;
                }

                html += `</div>`;
            });

            html += `</div>`;
            container.innerHTML = html;
        }

        function pilihJawapanKuiz(qId, selectedIdx) {
            const topic = syllabusData[activeTopicId];
            const q = topic.quizzes.find(item => item.id === qId);
            if (!q) return;

            const isCorrect = (selectedIdx === q.ans);
            appState.quizAnswers[qId] = {
                selected: selectedIdx,
                isCorrect: isCorrect
            };

            simpanDataLocalStorage();
            renderKuizPengukuhan(document.getElementById('topic-body-content'), topic);
            renderTopicProgressBars();
            kemaskiniIndikatorMastery();

            const badge = document.getElementById(`nav-topic-badge-${activeTopicId}`);
            if (badge) badge.innerText = `${kiraSkorTopik(activeTopicId)}%`;
            document.getElementById('topic-header-score').innerText = `${kiraSkorTopik(activeTopicId)}%`;

            if (isCorrect) {
                tunjukToast("Tahniah! Jawapan Tepat", "Skor kefahaman anda meningkat.");
            } else {
                tunjukToast("Kurang Tepat", "Sila rujuk skema penjelasan untuk pembetulan.");
            }
        }

        function kemaskiniRatingKendiri(val) {
            val = parseInt(val);
            appState.topicRatings[activeTopicId] = val;
            simpanDataLocalStorage();
            renderTopicProgressBars();
            kemaskiniIndikatorMastery();
            
            const badge = document.getElementById(`nav-topic-badge-${activeTopicId}`);
            if (badge) badge.innerText = `${kiraSkorTopik(activeTopicId)}%`;
            document.getElementById('topic-header-score').innerText = `${kiraSkorTopik(activeTopicId)}%`;

            tunjukToast("Penilaian Kendiri Dikemaskini", `Tahap kefahaman Topik ${activeTopicId} ditetapkan kepada ${val}/5.`);
        }

        // PERHITUNGAN SKOR & MASTERY LOGIC
        function kiraBetulKuizTopik(topicId) {
            const topic = syllabusData[topicId];
            let betul = 0;
            topic.quizzes.forEach(q => {
                if (appState.quizAnswers[q.id] && appState.quizAnswers[q.id].isCorrect) betul++;
            });
            return betul;
        }

        function kiraSkorTopik(topicId) {
            const topic = syllabusData[topicId];
            // Komponen Kuiz (60% berat)
            let qDijawab = 0;
            let qBetul = 0;
            topic.quizzes.forEach(q => {
                if (appState.quizAnswers[q.id] !== undefined) {
                    qDijawab++;
                    if (appState.quizAnswers[q.id].isCorrect) qBetul++;
                }
            });
            const quizPct = (qBetul / topic.quizzes.length) * 100;

            // Komponen Penilaian Kendiri (40% berat)
            const selfRating = appState.topicRatings[topicId] || 3;
            const selfPct = (selfRating / 5) * 100;

            // Jika belum ada soalan dijawab langsung, skor = 50% daripada self rating
            if (qDijawab === 0) {
                return Math.round(selfPct * 0.5);
            }
            return Math.round((quizPct * 0.65) + (selfPct * 0.35));
        }

        function renderTopicProgressBars() {
            const container = document.getElementById('topic-progress-bars');
            container.innerHTML = '';

            for (let i = 1; i <= 5; i++) {
                const topic = syllabusData[i];
                const score = kiraSkorTopik(i);
                
                let barColor = "bg-rose-500";
                if (score >= 90) barColor = "bg-emerald-400";
                else if (score >= 75) barColor = "bg-brand-teal";
                else if (score >= 50) barColor = "bg-amber-400";

                const div = document.createElement('div');
                div.className = "flex items-center gap-3 text-xs";
                div.innerHTML = `
                    <span class="w-24 truncate text-slate-300 font-semibold">${i}. ${topic.short}</span>
                    <div class="flex-1 bg-slate-950 h-2 rounded-full overflow-hidden border border-slate-800">
                        <div class="${barColor} h-full rounded-full transition-all duration-700" style="width: ${score}%"></div>
                    </div>
                    <span class="w-10 text-right font-mono font-bold text-slate-200">${score}%</span>
                `;
                container.appendChild(div);
            }
        }

        function kemaskiniIndikatorMastery() {
            let totalSkor = 0;
            for (let i = 1; i <= 5; i++) {
                totalSkor += kiraSkorTopik(i);
            }
            const overallScore = Math.round(totalSkor / 5);

            // Peratus Kuiz Selesai & Ketepatan
            let totalQuiz = 15;
            let answeredQuiz = 0;
            let correctQuiz = 0;

            for (let i = 1; i <= 5; i++) {
                syllabusData[i].quizzes.forEach(q => {
                    if (appState.quizAnswers[q.id] !== undefined) {
                        answeredQuiz++;
                        if (appState.quizAnswers[q.id].isCorrect) correctQuiz++;
                    }
                });
            }

            const accuracy = answeredQuiz > 0 ? Math.round((correctQuiz / answeredQuiz) * 100) : 0;

            document.getElementById('overall-quiz-ratio').innerText = `${answeredQuiz}/${totalQuiz}`;
            document.getElementById('overall-accuracy').innerText = `${accuracy}%`;

            // SVG Circular Gauge
            const circle = document.getElementById('gauge-circle');
            const circumference = 339.29; // 2 * pi * 54
            const offset = circumference - (overallScore / 100) * circumference;
            circle.style.strokeDashoffset = offset;

            document.getElementById('overall-percentage').innerText = `${overallScore}%`;

            // Warna & Status Indikator
            const statusText = document.getElementById('mastery-status-text');
            const descText = document.getElementById('mastery-desc-text');
            const dot = document.getElementById('mastery-indicator-dot');

            if (overallScore >= 90) {
                circle.setAttribute('stroke', '#34d399');
                statusText.innerText = "Cemerlang (90-100%)";
                statusText.className = "text-xl sm:text-2xl font-black text-emerald-400 mt-0.5 tracking-tight";
                dot.className = "w-2.5 h-2.5 rounded-full bg-emerald-400";
                descText.innerText = "Tahniah! Anda menguasai keseluruhan silibus DEG30073 dengan cemerlang dan bersedia sepenuhnya.";
            } else if (overallScore >= 75) {
                circle.setAttribute('stroke', '#00B4D8');
                statusText.innerText = "Mahir (75-89%)";
                statusText.className = "text-xl sm:text-2xl font-black text-brand-teal mt-0.5 tracking-tight";
                dot.className = "w-2.5 h-2.5 rounded-full bg-brand-teal";
                descText.innerText = "Penguasaan konsep dan formula yang kukuh. Teruskan latihan kalkulator dan soalan pengiraan.";
            } else if (overallScore >= 50) {
                circle.setAttribute('stroke', '#fbbf24');
                statusText.innerText = "Sederhana (50-74%)";
                statusText.className = "text-xl sm:text-2xl font-black text-amber-400 mt-0.5 tracking-tight";
                dot.className = "w-2.5 h-2.5 rounded-full bg-amber-400";
                descText.innerText = "Pemahaman asas dicapai. Disyorkan menyemak semula topik dengan peratusan rendah dan skema soalan.";
            } else {
                circle.setAttribute('stroke', '#f43f5e');
                statusText.innerText = "Perlu Bimbingan (<50%)";
                statusText.className = "text-xl sm:text-2xl font-black text-rose-400 mt-0.5 tracking-tight";
                dot.className = "w-2.5 h-2.5 rounded-full bg-rose-500 animate-pulse";
                descText.innerText = "Mulakan semakan nota kuliah, jawab soalan pengukuhan, dan laraskan tahap kefahaman kendiri topik anda.";
            }
        }

        // CALCULATOR LOGIC
        function kiraFillFactor() {
            const voc = parseFloat(document.getElementById('calc-voc').value) || 0;
            const isc = parseFloat(document.getElementById('calc-isc').value) || 0;
            const vmp = parseFloat(document.getElementById('calc-vmp').value) || 0;
            const imp = parseFloat(document.getElementById('calc-imp').value) || 0;

            if (voc <= 0 || isc <= 0) {
                document.getElementById('output-calc-pv').innerHTML = `<span class="text-xs text-rose-400">Ralat: Nilai Voc & Isc mesti &gt; 0</span>`;
                return;
            }

            const pmax = vmp * imp;
            const ff = pmax / (voc * isc);

            document.getElementById('output-calc-pv').innerHTML = `
                <span class="text-xs text-slate-300">Pmax: <strong class="text-white font-mono">${pmax.toFixed(2)} W</strong></span> | 
                <span class="text-xs text-brand-gold">FF: <strong class="font-mono">${ff.toFixed(3)}</strong> (${(ff * 100).toFixed(1)}%)</span>
            `;
            tunjukToast("Kalkulator PV", `Pmax: ${pmax.toFixed(2)}W | Fill Factor: ${ff.toFixed(3)}`);
        }

        function kiraWindPower() {
            const rho = parseFloat(document.getElementById('calc-wind-rho').value) || 1.225;
            const r = parseFloat(document.getElementById('calc-wind-radius').value) || 0;
            const v = parseFloat(document.getElementById('calc-wind-v').value) || 0;
            const eff = parseFloat(document.getElementById('calc-wind-eff').value) || 0.40;

            const area = Math.PI * Math.pow(r, 2);
            const totalPower = 0.5 * rho * area * Math.pow(v, 3); // Watts
            const extractedPower = totalPower * eff;

            document.getElementById('output-calc-wind').innerHTML = `
                <span class="text-xs text-slate-300">Total: <strong class="text-white font-mono">${(totalPower / 1000).toFixed(2)} kW</strong></span> | 
                <span class="text-xs text-brand-teal">Output: <strong class="font-mono">${(extractedPower / 1000).toFixed(2)} kW</strong></span>
            `;
            tunjukToast("Kalkulator Angin", `Kuasa yang diekstrak: ${(extractedPower / 1000).toFixed(2)} kW`);
        }

        function kiraHydroPower() {
            const q = parseFloat(document.getElementById('calc-hydro-q').value) || 0;
            const h = parseFloat(document.getElementById('calc-hydro-h').value) || 0;
            const eff = parseFloat(document.getElementById('calc-hydro-eff').value) || 0.85;

            const rho = 1000; // kg/m^3
            const g = 9.81;   // m/s^2

            const powerWatts = rho * g * q * h * eff;
            const pKw = powerWatts / 1000;
            const pMw = pKw / 1000;

            document.getElementById('output-calc-hydro').innerHTML = `
                <span class="text-xs text-slate-400">P Output = </span>
                <strong class="text-sky-300 font-mono text-xs">${pKw.toFixed(2)} kW</strong>
                <span class="text-[10px] text-slate-500 block font-mono">(${pMw.toFixed(3)} MW)</span>
            `;
            tunjukToast("Kalkulator Hidro", `Kuasa Dijana: ${pKw.toFixed(2)} kW`);
        }

        // TOAST ALERT NOTIFICATION
        function tunjukToast(title, msg) {
            const toast = document.getElementById('toast');
            document.getElementById('toast-title').innerText = title;
            document.getElementById('toast-msg').innerText = msg;

            toast.classList.remove('translate-y-20', 'opacity-0');
            toast.classList.add('translate-y-0', 'opacity-100');

            setTimeout(() => {
                toast.classList.remove('translate-y-0', 'opacity-100');
                toast.classList.add('translate-y-20', 'opacity-0');
            }, 3000);
        }
    </script>
</body>
</html>
