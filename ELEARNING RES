                </div>

                <!-- Sub-nav Tabs (Nota vs Kuiz Pengukuhan) -->
                <div class="bg-slate-900 px-4 sm:px-5 py-2.5 border-b border-slate-800 flex flex-wrap justify-between items-center gap-3">
                    <div class="flex items-center gap-2 text-xs">
                        <button onclick="setSubTab('nota')" id="tab-btn-nota" class="px-3.5 py-1.5 rounded-lg font-bold bg-brand-teal text-slate-950 shadow-sm transition">
                            <i class="fa-solid fa-book-bookmark mr-1"></i> Nota Padat Kuliah
                        </button>
