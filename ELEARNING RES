        <!-- SECTION 3: MINI INTERACTIVE ENGINEERING CALCULATORS -->
        <section id="quick-calculators" class="mt-8 bg-slate-900 border border-slate-800 rounded-2xl p-5 sm:p-6 shadow-xl">
            <div class="flex flex-wrap justify-between items-center pb-4 mb-6 border-b border-slate-800 gap-2">
                <div>
                    <span class="text-[10px] bg-brand-gold/10 text-brand-gold font-black uppercase px-2 py-0.5 rounded tracking-wider border border-brand-gold/20">
                        Amali & Pengiraan Silibus DEG30073
                    </span>
                    <h3 class="text-lg font-bold text-white mt-1 flex items-center gap-2">
                        <i class="fa-solid fa-microchip text-brand-teal"></i>
                        Kalkulator Kejuruteraan Tenaga Boleh Baharu
                    </h3>
                </div>
                <p class="text-xs text-slate-400 max-w-md">Gunakan kalkulator di bawah untuk membuat semakan pengiraan tutorial, ujian makmal, dan latihan peperiksaan.</p>
